# local agent/config state - never commit
CLAUDE.local.md
.claude/settings.local.json
# secrets - keep the example, ignore the rest
.env*
!.env.example
# Rust build output
/target
# agent worktrees and probe output
.claude/worktrees/
probe-results/
/probes/*/target/
# key containers (the secret check also fails on a tracked path with these extensions)
*.pfx
*.p12
*.p8
*.key
*.pem
*.jks
*.keystore
*.der
*.pk8
*.pkcs12
*.ppk
